{
  "name": "dsh-deepseek-balance",
  "version": "0.1.0",
  "private": true,
  "description": "Quiet DeepSeek API balance chip for the DSH Web composer: remaining CNY/USD and a manual refresh. Keys stay on the host.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "parse.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/dsh-deepseek-balance.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
